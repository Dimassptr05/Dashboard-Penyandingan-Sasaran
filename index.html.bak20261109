<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>Dashboard Relasi Antar-Sasaran Reformasi Birokrasi</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="style.css?v=20261105_v6">
</head>

<body>
  <div class="app-layout">
    <!-- ======================================================== -->
    <!-- SIDEBAR UTAMA (LOGO TETAP SESUAI KETENTUAN USER)        -->
    <!-- ======================================================== -->
    <aside class="sidebar">
      <div class="brand brand-clean">
        <div class="brand-info">
          <h1>Portal Relasi RB</h1>
          <p>Kementerian PANRB</p>
        </div>
      </div>

      <div class="sidebar-nav-title">Menu Utama</div>
      <nav class="sidebar-menu">
        <button class="nav-btn active" id="menuInternal" data-menu="internal">
          <span class="nav-icon">⤳</span>
          <span class="nav-text">Relasi Internal</span>
        </button>
        <button class="nav-btn" id="menuExternal" data-menu="external">
          <span class="nav-icon">⇄</span>
          <span class="nav-text">Relasi Eksternal</span>
        </button>
      </nav>
    </aside>

    <!-- ======================================================== -->
    <!-- KONTEN UTAMA DENGAN 3 TAHAPAN NAVIGASI STANDAR           -->
    <!-- ======================================================== -->
    <div class="main-content">
      <!-- Topbar Header & Breadcrumbs & Stepper -->
      <!-- 1. BREADCRUMB (Posisi Teratas) -->
      <nav class="breadcrumb-nav-bar" aria-label="Breadcrumb">
        <div class="breadcrumbs">
          <span class="bc-item">Portal RB</span>
          <span class="bc-sep">›</span>
          <span class="bc-item" id="bcMenu">Relasi Internal</span>
          <span class="bc-sep">›</span>
          <span class="bc-item" id="bcScope">Sasaran 5</span>
          <span class="bc-sep">›</span>
          <span class="bc-item active" id="bcStage">Tahap 1: Matriks Relasi</span>
        </div>
      </nav>

      <!-- 2. HEADER HALAMAN (Judul halaman, tombol kembali, ringkasan hubungan) -->
      <header class="page-top-header" id="pageTopHeader">
        <div class="page-header-titles">
          <h1 class="page-heading-title" id="pageHeadingTitle">Matriks Relasi Internal</h1>
          <p class="page-heading-subtitle" id="pageHeadingSubtitle">Sasaran 5 — Pelayanan Publik</p>
        </div>
        <div class="page-header-meta">
          <button class="btn-nav-back hidden" id="btnGlobalBack" title="Kembali ke tahapan sebelumnya">
            <span>←</span>
            <span id="btnGlobalBackText">Kembali</span>
          </button>
          <div class="summary-pill" id="topbarSummaryPill">
            <span class="summary-dot"></span>
            <span id="topbarSummaryText">Sasaran 5: 49 Pasangan Indikator (IPP)</span>
          </div>
        </div>
      </header>

      <!-- 3. STEPPER TAHAP 1 - 2 - 3 (Di bawah header halaman, di atas filter) -->
      <div class="stepper-process-bar">
        <div class="stepper-track">
          <button class="step-item active" id="step1Btn" data-target-stage="matrix">
            <span class="step-num">1</span>
            <span class="step-label">Matriks Relasi</span>
          </button>
          <div class="step-line" id="stepLine1"></div>
          <button class="step-item" id="step2Btn" data-target-stage="graph">
            <span class="step-num">2</span>
            <span class="step-label">Peta Relasi</span>
          </button>
          <div class="step-line" id="stepLine2"></div>
          <button class="step-item" id="step3Btn" data-target-stage="list">
            <span class="step-num">3</span>
            <span class="step-label">Daftar Relasi</span>
          </button>
        </div>
      </div>

      <!-- Filter Bar Utama Sesuai Format Revisi -->
      <section class="filter-bar" id="mainFilterBar">
        <div class="filter-controls-row">
          <!-- Dropdown Pilihan Sasaran Strategis (Menu Internal: Sasaran 3, 4, 5) -->
          <div class="filter-group" id="groupInternalSasaranSelect">
            <label for="selectInternalSasaran">
              <span>Sasaran Strategis</span>
            </label>
            <select id="selectInternalSasaran" class="select-input">
              <option value="5" selected>Sasaran 5 — Pelayanan Publik</option>
              <option value="4">Sasaran 4 — Kapabilitas Kelembagaan</option>
              <option value="3">Sasaran 3 — Integritas &amp; Inovasi (Data Perlu Diperjelas)</option>
            </select>
          </div>

          <!-- Dropdown Sasaran Sumber (Menu Eksternal: Sasaran 1 aktif, Sasaran 2-5 abu-abu/disabled) -->
          <div class="filter-group hidden" id="groupExtSourceSasaranSelect">
            <label for="selectExtSourceSasaran" id="labelExtSourceSasaran">
              <span>Sasaran Sumber</span>
            </label>
            <select id="selectExtSourceSasaran" class="select-input">
              <option value="1" selected>Sasaran 1 (Transformasi Digital)</option>
              <option value="2" disabled class="option-disabled">Sasaran 2 (Sistem Merit)</option>
              <option value="3" disabled class="option-disabled">Sasaran 3 (Integritas &amp; Inovasi)</option>
              <option value="4" disabled class="option-disabled">Sasaran 4 (Kapabilitas Kelembagaan)</option>
              <option value="5" disabled class="option-disabled">Sasaran 5 (Pelayanan Publik)</option>
            </select>
          </div>

          <!-- Dropdown Sasaran Tujuan (Menu Eksternal: Sasaran 2 s.d. 5 aktif, Sasaran 1 abu-abu/disabled) -->
          <div class="filter-group hidden" id="groupExtDestSasaranSelect">
            <label for="selectExtDestSasaran" id="labelExtDestSasaran">
              <span>Sasaran Tujuan</span>
            </label>
            <select id="selectExtDestSasaran" class="select-input">
              <option value="ALL" selected>Semua Sasaran Tujuan</option>
              <option value="1" disabled class="option-disabled">Sasaran 1 (Transformasi Digital)</option>
              <option value="2">Sasaran 2 (Sistem Merit)</option>
              <option value="3">Sasaran 3 (Integritas &amp; Inovasi)</option>
              <option value="4">Sasaran 4 (Kapabilitas Kelembagaan)</option>
              <option value="5">Sasaran 5 (Pelayanan Publik)</option>
            </select>
          </div>

          <!-- Dropdown Indeks Sumber -->
          <div class="filter-group" id="groupSourceSelect">
            <label for="selectSource" id="labelSourceSelect">
              <span>Indeks Sumber</span>
            </label>
            <select id="selectSource" class="select-input">
              <!-- Dimuat dinamis oleh app.js -->
            </select>
          </div>

          <!-- Dropdown Indikator Sumber -->
          <div class="filter-group" id="groupComponentSelect">
            <label for="selectComponent" id="labelComponentSelect">
              <span>Indikator</span>
            </label>
            <select id="selectComponent" class="select-input">
              <!-- Dimuat dinamis oleh app.js -->
            </select>
          </div>

          <!-- Dropdown Indeks Pembanding -->
          <div class="filter-group" id="groupDestinationSelect">
            <label for="selectDestination" id="labelDestinationSelect">
              <span>Indeks Pembanding</span>
            </label>
            <select id="selectDestination" class="select-input">
              <!-- Dimuat dinamis oleh app.js -->
            </select>
          </div>
        </div>

        <div class="filter-controls-row second-row">
          <!-- Filter Jenis Keterkaitan -->
          <div class="filter-group" id="groupRelationTypeSelect">
            <label for="selectRelationType">
              <span>Jenis Keterkaitan</span>
            </label>
            <select id="selectRelationType" class="select-input">
              <!-- Dimuat dinamis oleh app.js -->
            </select>
          </div>

          <!-- Pencarian Bebas -->
          <div class="filter-group filter-search-group">
            <label for="inputSearchFree">Pencarian Bebas</label>
            <div class="search-input-wrapper">
              <svg class="search-icon-inside" viewBox="0 0 24 24" width="15" height="15" stroke="#94a3b8"
                stroke-width="2" fill="none">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
              </svg>
              <input type="text" id="inputSearchFree" class="search-input"
                placeholder="Cari nama indeks, indikator, kode, atau alasan...">
            </div>
          </div>

          <!-- Tombol Reset Filter -->
          <div class="filter-actions">
            <button class="btn btn-secondary btn-reset-pill" id="btnResetFilters"
              title="Kembalikan filter ke kondisi awal">
              <span class="reset-icon-svg">↺</span>
              <span>Reset Filter</span>
            </button>
          </div>
        </div>

        <!-- Penjelasan Logika Agregasi / Hint -->
        <div class="logic-hint-banner" id="logicNote">
          <!-- Diisi dinamis oleh app.js -->
        </div>

        <!-- Banner Konteks Pasangan Aktif -->
        <div class="context-banner hidden" id="contextBanner">
          <div class="context-left">
            <span class="context-tag" id="contextTag">Lingkup Aktif</span>
            <span class="context-text" id="contextText">Silakan pilih sel pada matriks untuk membedah hubungan di Peta
              Relasi.</span>
          </div>
          <div class="context-right" id="contextActions">
            <!-- Dynamic context actions -->
          </div>
        </div>
      </section>

      <!-- ======================================================== -->
      <!-- TAHAP 1: MATRIKS RELASI                                  -->
      <!-- ======================================================== -->
      <section class="stage-view active" id="stageMatrix">
        <div class="panel">
          <!-- Kartu Statistik Ringkas Matriks (Text-First, Bersih Tanpa Ikon Dekoratif) -->
          <div class="stage-stat-summary-bar">
            <!-- Hidden helper labels for JS title sync -->
            <span id="matrixTitle" class="hidden">Matriks Relasi Internal</span>
            <span id="matrixDesc" class="hidden">Sasaran 5 — Pelayanan Publik</span>

            <div class="hero-kpi-grid">
              <div class="kpi-mini-card kpi-text-only">
                <div class="kpi-info">
                  <strong id="pairCount">49</strong>
                  <small id="pairUnit">Pasangan Indikator</small>
                </div>
              </div>
              <div class="kpi-mini-card kpi-text-only">
                <div class="kpi-info">
                  <strong id="heroStatPoints">128</strong>
                  <small id="heroStatPointsUnit">Indikator Titik</small>
                </div>
              </div>
              <div class="kpi-mini-card kpi-text-only">
                <div class="kpi-info">
                  <strong id="heroStatAspects">4</strong>
                  <small id="heroStatAspectsUnit">Aspek</small>
                </div>
              </div>
              <div class="kpi-mini-card kpi-text-only">
                <div class="kpi-info">
                  <strong id="heroStatComparators">3</strong>
                  <small id="heroStatComparatorsUnit">Indeks Pembanding</small>
                </div>
              </div>
            </div>

            <button class="btn btn-secondary btn-sm" id="btnExportPdfMatrix" style="display:none;"
              title="Unduh Matriks Relasi dalam format PDF">
              <span>Unduh PDF Matriks</span>
            </button>
          </div>

          <!-- Area Matriks -->
          <div class="matrix-scroll-wrapper">
            <div id="matrixTableContainer">
              <!-- Matriks dirender secara dinamis oleh app.js -->
            </div>
          </div>

          <div class="matrix-footer-fineprint" id="matrixFineprint">
            <span class="fineprint-text">
              ℹ <strong>Satuan Penghitungan:</strong> Angka pada sel matriks adalah jumlah <strong>indikator tujuan
                unik</strong> yang memiliki rujukan tercatat, bukan banyaknya permutasi kombinasi kode indikator skala
              penilaian.
            </span>
          </div>
        </div>
      </section>

      <!-- ======================================================== -->
      <!-- TAHAP 2: PETA RELASI (HANYA KARTU BERELASI)              -->
      <!-- ======================================================== -->
      <section class="stage-view hidden" id="stageGraph">
        <div class="panel">
          <!-- Kartu Statistik Ringkas Peta (Text-First, Tanpa Ikon Bulat Besar) -->
          <div class="stage-stat-summary-bar">
            <!-- Hidden helper labels for JS title sync -->
            <span id="graphTitle" class="hidden">Peta Relasi</span>
            <span id="graphDesc" class="hidden">Visualisasi hubungan indikator antar indeks pada Sasaran 4 — Kapabilitas
              Kelembagaan</span>

            <div class="hero-kpi-grid">
              <div class="kpi-mini-card kpi-text-only">
                <div class="kpi-info">
                  <strong id="mapTotal">168</strong>
                  <small id="mapUnit">Hubungan</small>
                </div>
              </div>
              <div class="kpi-mini-card kpi-text-only">
                <div class="kpi-info">
                  <strong id="graphInstCount">8</strong>
                  <small id="graphInstCountUnit">Indeks</small>
                </div>
              </div>
              <button class="btn btn-secondary btn-icon-expand" id="btnExpandGraph" title="Perbesar Tampilan Diagram">
                <span>⤢</span>
              </button>
              <button class="btn btn-secondary btn-sm" id="btnBackToMatrixFromGraph" style="display:none;">
                <span>← Kembali ke Matriks</span>
              </button>
              <button class="btn btn-secondary btn-sm" id="btnExportPdfGraph" style="display:none;"
                title="Unduh Peta Relasi dalam format PDF">
                <span>Unduh PDF Peta</span>
              </button>
              <button class="btn btn-primary btn-sm" id="btnGoToListFromGraph" style="display:none;">
                <span>Buka Tabel Rincian (Tahap 3) →</span>
              </button>
            </div>
          </div>

          <!-- Toolbar Peta Relasi: Tab Filter Indeks & Mode Fokus Interaktif -->
          <div class="graph-toolbar" id="graphToolbar">
            <div class="graph-inst-tabs" id="graphInstTabs">
              <!-- Dimuat dinamis oleh renderStageGraph(): [Semua] [IPP] [OP] [IKK] [ZI] -->
            </div>
            <div class="graph-display-mode-group">
              <span class="graph-inst-tabs-label">Tampilan Garis:</span>
              <button class="btn btn-sm btn-outline-primary btn-graph-mode active" id="btnGraphModeFocus"
                title="Tampilkan garis terfokus saat kursor menunjuk kartu agar tampilan bersih">
                <span>🎯 Mode Fokus (Bersih)</span>
              </button>
              <button class="btn btn-sm btn-outline-secondary btn-graph-mode" id="btnGraphModeAll"
                title="Tampilkan seluruh garis relasi secara bersamaan">
                <span>🕸 Semua Garis</span>
              </button>
            </div>
          </div>

          <!-- Kanvas Diagram Dua Kolom & SVG Garis Melengkung -->
          <div class="diagram-viewport" id="diagramViewport">
            <!-- SVG Canvas untuk Kurva Bezier Halus -->
            <svg class="diagram-svg" id="diagramSvg">
              <defs>
                <marker id="arrowMendukung" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
                  markerUnits="userSpaceOnUse">
                  <path d="M 1 1 L 7 4 L 1 7 Z" fill="#0284c7" />
                </marker>
                <marker id="arrowMelengkapi" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
                  markerUnits="userSpaceOnUse">
                  <path d="M 1 1 L 7 4 L 1 7 Z" fill="#10b981" />
                </marker>
                <marker id="arrowBeririsan" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
                  markerUnits="userSpaceOnUse">
                  <path d="M 1 1 L 7 4 L 1 7 Z" fill="#8b5cf6" />
                </marker>
                <marker id="arrowTumpangTindih" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
                  markerUnits="userSpaceOnUse">
                  <path d="M 1 1 L 7 4 L 1 7 Z" fill="#f59e0b" />
                </marker>
                <marker id="arrowSelaras" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
                  markerUnits="userSpaceOnUse">
                  <path d="M 1 1 L 7 4 L 1 7 Z" fill="#06b6d4" />
                </marker>
                <marker id="arrowActive" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
                  markerUnits="userSpaceOnUse">
                  <path d="M 1 1 L 7 4 L 1 7 Z" fill="#0284c7" />
                </marker>
                <!-- Marker khusus relasi makro eksternal -->
                <marker id="arrowMacroExternal" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"
                  markerUnits="userSpaceOnUse">
                  <path d="M 1 1 L 7 4 L 1 7 Z" fill="#0f766e" />
                </marker>
                <marker id="arrowMacroExternalHover" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto"
                  markerUnits="userSpaceOnUse">
                  <path d="M 1 1 L 8 4.5 L 1 8 Z" fill="#0d9488" />
                </marker>
              </defs>
              <g id="svgPathGroup"></g>
            </svg>

            <!-- Grid 2 Kolom: Sumber (Kiri) dan Tujuan (Kanan) -->
            <div class="diagram-columns-grid">
              <!-- Kolom Kiri: Sumber Hubungan -->
              <div class="diagram-column column-source">
                <div class="column-header">
                  <span class="column-title" id="colSourceTitle">Indeks / Indikator Sumber</span>
                  <span class="badge badge-light" id="colSourceCount">0 Kartu</span>
                </div>
                <div class="cards-stack" id="containerSourceCards">
                  <!-- Kartu sumber dimuat dinamis -->
                </div>
              </div>

              <!-- Kolom Kanan: Tujuan Hubungan -->
              <div class="diagram-column column-dest">
                <div class="column-header">
                  <span class="column-title" id="colDestTitle">Indeks / Indikator Pembanding</span>
                  <span class="badge badge-light" id="colDestCount">0 Kartu</span>
                </div>
                <div class="cards-stack" id="containerDestCards">
                  <!-- Kartu tujuan dimuat dinamis -->
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ======================================================== -->
      <!-- TAHAP 3: DAFTAR RELASI LENGKAP                           -->
      <!-- ======================================================== -->
      <section class="stage-view hidden" id="stageList">
        <div class="panel">
          <!-- Bar Aksi Tahap 3 (Bersih Tanpa Ikon Bulat Besar) -->
          <div class="stage-list-action-bar">
            <!-- Hidden helper labels for JS title sync -->
            <span id="listTitle" class="hidden">Detail Relasi</span>
            <span id="listDesc" class="hidden">Rincian hubungan indikator sesuai lingkup terpilih.</span>

            <div class="list-top-actions">
              <button class="btn btn-outline-secondary btn-action-pill" id="btnBackToGraphFromList">
                <span>← Kembali ke Peta</span>
              </button>
              <button class="btn btn-outline-secondary btn-action-pill" id="btnBackToMatrixFromList">
                <span>← Kembali ke Matriks</span>
              </button>
              <button class="btn btn-primary btn-action-pill btn-export-csv-solid" id="btnExportCsv">
                <span>Ekspor CSV</span>
              </button>
              <button class="btn btn-secondary btn-action-pill" id="btnExportPdfList" style="display:none;"
                title="Unduh Daftar Relasi dalam format PDF">
                <span>Unduh PDF Daftar</span>
              </button>
            </div>
          </div>

          <!-- Filter jenis dan jumlah relasi (hasil aktual, sebelum daftar tabel) -->
          <div class="list-summary-toolbar" aria-label="Filter jenis keterkaitan">
            <div class="list-summary-count" role="status" aria-live="polite">
              <strong id="listVisibleCount">0</strong>
              <div>
                <span>Catatan relasi ditampilkan</span>
                <small id="listCountSummary">dari 0 catatan pada lingkup ini</small>
              </div>
            </div>
            <div class="list-type-filter">
              <span class="list-type-title">Filter jenis keterkaitan <small>(pilih satu atau lebih)</small></span>
              <div class="list-type-options" id="listTypeOptions"></div>
            </div>
          </div>

          <!-- Rincian Single Focus (Jika Dipilih dari Klik Kartu/Garis) -->
          <div class="focus-relation-card hidden" id="focusRelationCard">
            <!-- Kartu detail relasi fokus -->
          </div>

          <div class="detail-intro-notice" id="detailIntroNotice"></div>

          <!-- Tabel Rincian Relasi -->
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th style="width: 50px; text-align: center;">No.</th>
                  <th>Indikator Sumber</th>
                  <th>Indikator Pembanding</th>
                  <th style="width: 180px;">Jenis Keterkaitan</th>
                  <th style="width: 140px; text-align: center;">Aksi Detail</th>
                </tr>
              </thead>
              <tbody id="tableRelationBody">
                <!-- Baris tabel dimuat dinamis oleh app.js -->
              </tbody>
            </table>
          </div>

          <div class="moreline hidden" id="tableMoreNotice"></div>

          <!-- State Kosong jika tidak ada hasil -->
          <div class="empty-state hidden" id="listEmptyState">
            <div class="empty-icon">🔍</div>
            <h3>Tidak ada relasi pada pasangan yang dipilih</h3>
            <p>Silakan gunakan tombol reset atau pilih pasangan lain pada Matriks Relasi.</p>
            <button class="btn btn-secondary" id="btnEmptyReset">Reset Filter</button>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- ======================================================== -->
  <!-- MODAL ARSITEKTUR & METADATA SISTEM                      -->
  <!-- ======================================================== -->
  <div class="modal-backdrop" id="modalArchitecture">
    <div class="modal-dialog">
      <div class="modal-header">
        <div class="modal-title">
          <h3>Arsitektur &amp; Kepatuhan Data Portal RB</h3>
          <p>Dokumentasi Teknis &amp; Integritas Data Offline (file://)</p>
        </div>
        <button class="modal-close" id="btnCloseModal">✕</button>
      </div>
      <div class="modal-body">
        <h4>1. Kepatuhan Bebas CORS &amp; API</h4>
        <p>Aplikasi ini dibangun murni menggunakan <strong>HTML5, CSS3, dan Vanilla JavaScript</strong>. Data relasi
          disimpan dalam format variabel global yang langsung di-load melalui tag <code>&lt;script&gt;</code> sebelum
          logika aplikasi dieksekusi.</p>
        <h4>2. Integritas Data</h4>
        <p>Data internal dan eksternal disinkronkan secara ketat dengan master spreadsheet Reformasi Birokrasi.</p>
        <ul>
          <li><strong>Sasaran 4:</strong> 168 hubungan internal terdata secara substantif.</li>
          <li><strong>Sasaran 5:</strong> 2.205 hubungan dinormalisasi antar-indeks IPP, OP, IKK, dan ZI.</li>
          <li><strong>Sasaran 1 (Eksternal):</strong> 1.631 hubungan rujukan dari Pemerintah Digital ke instrumen mitra.
          </li>
        </ul>
      </div>
      <div class="modal-footer">
        <button class="btn btn-primary" id="btnDismissModal">Tutup Dokumentasi</button>
      </div>
    </div>
  </div>

  <!-- MODAL PREVIEW DOKUMEN PDF RESMI (SEBELUM DOWNLOAD) -->
  <div class="pdf-preview-modal-overlay hidden" id="pdfPreviewModal" role="dialog" aria-modal="true"
    aria-labelledby="pdfPreviewTitle">
    <div class="pdf-preview-modal-container">
      <div class="pdf-preview-modal-header">
        <div class="pdf-preview-modal-title-wrap">
          <span class="pdf-preview-badge">PREVIEW DOKUMEN PDF RESMI</span>
          <h3 class="pdf-preview-modal-title" id="pdfPreviewTitle">Laporan Dokumen PDF</h3>
          <p class="pdf-preview-modal-subtitle" id="pdfPreviewSubtitle">Periksa tampilan seluruh halaman sebelum
            mengunduh.</p>
        </div>
        <div class="pdf-preview-modal-actions">
          <button class="btn btn-secondary btn-sm" id="btnPdfPreviewClose">
            <span>✕ Tutup</span>
          </button>
          <button class="btn btn-primary btn-sm" id="btnPdfPreviewDownload"
            style="background:#0284c7; border-color:#0284c7; font-weight:700;">
            <span>⬇ Download PDF</span>
          </button>
        </div>
      </div>
      <div class="pdf-preview-modal-body" id="pdfPreviewBody">
        <iframe id="pdfPreviewIframe" class="pdf-preview-iframe" title="Pratinjau PDF"></iframe>
      </div>
    </div>
  </div>

