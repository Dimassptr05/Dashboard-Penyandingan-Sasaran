    sasaran4Justifikasi: {
      "SS4-KK.KF.1.1_SS4-SPIP.1.1": {
            "jenis": "Mendukung",
            "alasan": "Kesesuaian tugas pokok dan fungsi organisasi dengan mandat peraturan perundang-undangan, arah kebijakan nasional, dan kebutuhan strategis instansi pemerintah pada indikator Mandat (Core Function) — pernyataan Relevansi (aspek Ketepatan Fungsi) mendukung tingkat pencapaian sasaran strategis instansi pemerintah secara tepat guna, hemat sumber daya, dan berdaya hasil tinggi sesuai target pada sub uraian Efektivitas dan Efisiensi (komponen Sasaran Strategis K/L/D) SPIP.",
            "rekomendasi": "Disarankan menyelaraskan evaluasi relevansi tugas pokok dan fungsi organisasi terhadap mandat peraturan perundang-undangan, arah kebijakan nasional, dan kebutuhan strategis instansi dengan penerapan Unsur SPIP (Lingkungan Pengendalian, Penilaian Risiko, Kegiatan Pengendalian, Informasi & Komunikasi, dan Pemantauan) guna mendukung efektivitas dan efisiensi pencapaian sasaran strategis K/L/D."
      },
      "SS4-KK.KF.1.1_SS4-SPIP.1.2": {
            "jenis": "Mendukung",
            "alasan": "Kesesuaian tugas pokok dan fungsi organisasi dengan mandat peraturan perundang-undangan, arah kebijakan nasional, dan kebutuhan strategis instansi pemerintah pada indikator Mandat (Core Function) — pernyataan Relevansi (aspek Ketepatan Fungsi) mendukung kejelasan tanggung jawab pelaksanaan tugas dalam mewujudkan penyajian laporan keuangan yang wajar, tepat waktu, akurat, dan dapat dipertanggungjawabkan sesuai Standar Akuntansi Pemerintahan (SAP) pada sub uraian Keandalan Pelaporan Keuangan (komponen Sasaran Strategis K/L/D) SPIP.",
            "rekomendasi": "Disarankan menyelaraskan penataan tugas pokok dan fungsi organisasi sesuai mandat peraturan perundang-undangan dan arah kebijakan nasional dengan penerapan Unsur SPIP pada komponen Sasaran Strategis K/L/D guna menjamin keandalan pelaporan keuangan sesuai Standar Akuntansi Pemerintahan (SAP)."
      },
      "SS4-KK.KF.1.1_SS4-SPIP.2.1": {
            "jenis": "Mendukung",
            "alasan": "Kesesuaian tugas pokok dan fungsi organisasi dengan mandat peraturan perundang-undangan, arah kebijakan nasional, dan kebutuhan strategis instansi pemerintah pada indikator Mandat (Core Function) — pernyataan Relevansi (aspek Ketepatan Fungsi) mendukung pengendalian intern untuk melindungi aset dan BMN dari risiko kehilangan, kerusakan, pemborosan, penyalahgunaan, maupun pemanfaatan yang tidak sah pada sub uraian Pengamanan Aset Negara (komponen Strategi Pencapaian Sasaran Strategis) SPIP.",
            "rekomendasi": "Disarankan menyelaraskan penetapan tugas pokok dan fungsi organisasi sesuai mandat peraturan perundang-undangan dan kebutuhan strategis instansi dengan penerapan Unsur SPIP pada komponen Strategi Pencapaian Sasaran Strategis guna memperkuat pengendalian intern atas pengamanan aset negara dan BMN."
      },
      "SS4-KK.KF.1.1_SS4-SPIP.2.2": {
            "jenis": "Mendukung",
            "alasan": "Kesesuaian tugas pokok dan fungsi organisasi dengan mandat peraturan perundang-undangan, arah kebijakan nasional, dan kebutuhan strategis instansi pemerintah pada indikator Mandat (Core Function) — pernyataan Relevansi (aspek Ketepatan Fungsi) mendukung kepatuhan seluruh unit kerja dan aparatur terhadap ketentuan hukum, peraturan perundang-undangan, dan standar operasional prosedur yang berlaku pada sub uraian Ketaatan Terhadap Peraturan Perundang-undangan (komponen Strategi Pencapaian Sasaran Strategis) SPIP.",
            "rekomendasi": "Disarankan menyelaraskan evaluasi kesesuaian tugas pokok dan fungsi organisasi terhadap mandat peraturan perundang-undangan dengan penerapan Unsur SPIP pada komponen Strategi Pencapaian Sasaran Strategis guna memastikan ketaatan seluruh unit kerja dan aparatur terhadap ketentuan hukum serta prosedur yang berlaku."
      },
      "SS4-KK.KU.1.1_SS4-IPPN.2.a.1": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi agar tidak terjadi kelebihan atau kekurangan beban tugas pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) memiliki keselarasan perencanaan dengan kesesuaian anggaran output prioritas dalam RKA K/L pada tahun perencanaan terhadap anggaran output proyek prioritas di dalam koridor Prioritas Nasional RKP pada indikator Kepatuhan Anggaran K/L untuk Membiayai Output IPPN.",
            "rekomendasi": "Disarankan menyelaraskan penataan distribusi beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali dengan perencanaan anggaran output prioritas dalam RKA K/L pada tahun perencanaan agar sesuai dengan anggaran output proyek prioritas di dalam koridor Prioritas Nasional RKP pada IPPN."
      },
      "SS4-KK.KU.1.1_SS4-IPPN.2.b.1": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) memiliki keselarasan perencanaan dengan kesesuaian total anggaran dalam RKA K/L terhadap total anggaran pada Renja K/L dalam indikator Kesesuaian Anggaran RKA dengan Anggaran Renja K/L pada IPPN.",
            "rekomendasi": "Disarankan menyelaraskan proporsionalitas distribusi beban kerja antar-tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali dengan penyusunan total anggaran dalam RKA K/L agar konsisten dan sesuai dengan total anggaran pada Renja K/L dalam IPPN."
      },
      "SS4-KK.KU.1.1_SS4-IPPN.2.c.1": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) memiliki keselarasan perencanaan dengan kesesuaian anggaran output prioritas dalam RKA K/L pada tahun pelaksanaan terhadap anggaran output proyek prioritas di dalam koridor Prioritas Nasional RKP pada indikator Kepatuhan Anggaran K/L untuk Membiayai Output Prioritas RKP pada Tahun Pelaksanaan IPPN.",
            "rekomendasi": "Disarankan menyelaraskan pengaturan distribusi beban kerja unit organisasi pada indikator Rentang Kendali dengan pengalokasian anggaran output prioritas dalam RKA K/L pada tahun pelaksanaan agar sesuai dengan anggaran output proyek prioritas di dalam koridor Prioritas Nasional RKP pada IPPN."
      },
      "SS4-KK.KU.1.1_SS4-IKPA.1.1": {
            "jenis": "Potensi Tumpang Tindih",
            "alasan": "Penilaian proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) berpotensi tumpang tindih dengan evaluasi kesesuaian perencanaan dan kedisiplinan satker dalam meminimalisir frekuensi revisi anggaran DIPA dalam satu tahun anggaran pada indikator Revisi DIPA (aspek Kualitas Perencanaan Anggaran) IKPA apabila penyesuaian pembagian beban tugas dan alokasi kegiatan satker dievaluasi secara terpisah.",
            "rekomendasi": "Disarankan menyinkronkan analisis distribusi beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali dengan perencanaan anggaran satker pada indikator Revisi DIPA IKPA guna meminimalisir frekuensi revisi DIPA dalam satu tahun anggaran."
      },
      "SS4-KK.KU.1.1_SS4-IKPA.1.2": {
            "jenis": "Potensi Tumpang Tindih",
            "alasan": "Penilaian proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) berpotensi tumpang tindih dengan evaluasi tingkat kesesuaian antara realisasi penarikan dana dengan rencana penarikan dana bulanan yang tercantum pada Halaman III DIPA dalam indikator Deviasi Halaman III DIPA (aspek Kualitas Perencanaan Anggaran) IKPA.",
            "rekomendasi": "Disarankan menyelaraskan pengaturan sebaran volume dan beban kerja unit organisasi pada indikator Rentang Kendali dengan penyusunan serta pelaksanaan rencana penarikan dana bulanan pada Halaman III DIPA guna menekan deviasi penarikan dana pada IKPA."
      },
      "SS4-KK.KU.1.1_SS4-IKPA.2.1": {
            "jenis": "Potensi Tumpang Tindih",
            "alasan": "Penilaian proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) berpotensi tumpang tindih dengan pengukuran proporsi realisasi anggaran belanja satker terhadap pagu DIPA sesuai target penyerapan triwulanan pada indikator Penyerapan Anggaran (aspek Kualitas Pelaksanaan Anggaran) IKPA.",
            "rekomendasi": "Disarankan menyelaraskan evaluasi proporsionalitas distribusi beban kerja unit organisasi pada indikator Rentang Kendali dengan pengendalian realisasi anggaran belanja satker terhadap pagu DIPA agar target penyerapan anggaran triwulanan pada IKPA tercapai secara proporsional."
      },
      "SS4-KK.KU.1.1_SS4-IKPA.2.2": {
            "jenis": "Potensi Tumpang Tindih",
            "alasan": "Penilaian proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) berpotensi tumpang tindih dengan evaluasi kedisiplinan satker dalam pendaftaran data kontrak pengadaan barang/jasa ke KPPN paling lambat 5 hari kerja setelah kontrak ditandatangani pada indikator Belanja Kontraktual (aspek Kualitas Pelaksanaan Anggaran) IKPA.",
            "rekomendasi": "Disarankan menyelaraskan pembagian beban kerja manajerial dan unit organisasi pada indikator Rentang Kendali dengan pengendalian ketepatan waktu pendaftaran data kontrak pengadaan barang/jasa ke KPPN maksimal 5 hari kerja setelah kontrak ditandatangani pada indikator Belanja Kontraktual IKPA."
      },
      "SS4-KK.KU.1.1_SS4-IKPA.2.3": {
            "jenis": "Potensi Tumpang Tindih",
            "alasan": "Penilaian proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) berpotensi tumpang tindih dengan evaluasi ketepatan waktu penerbitan Surat Perintah Membayar (SPM) ke KPPN maksimal 17 hari kerja sejak timbulnya hak tagih (BAST) pada indikator Penyelesaian Tagihan (aspek Kualitas Pelaksanaan Anggaran) IKPA.",
            "rekomendasi": "Disarankan menyelaraskan penataan distribusi beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali dengan pengendalian ketepatan waktu penerbitan Surat Perintah Membayar (SPM) ke KPPN maksimal 17 hari kerja sejak timbulnya hak tagih (BAST) pada indikator Penyelesaian Tagihan IKPA."
      },
      "SS4-KK.KU.1.1_SS4-IKPA.2.4": {
            "jenis": "Potensi Tumpang Tindih",
            "alasan": "Penilaian proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) berpotensi tumpang tindih dengan evaluasi ketertiban dan kecepatan pertanggungjawaban Uang Persediaan (UP) dan Tambahan Uang Persediaan (TUP) secara bergulir (revolving) pada indikator Pengelolaan UP dan TUP (aspek Kualitas Pelaksanaan Anggaran) IKPA.",
            "rekomendasi": "Disarankan menyelaraskan proporsionalitas distribusi beban kerja unit organisasi pada indikator Rentang Kendali dengan pengendalian ketertiban serta kecepatan pertanggungjawaban Uang Persediaan (UP) dan Tambahan Uang Persediaan (TUP) secara bergulir (revolving) pada IKPA."
      },
      "SS4-KK.KU.1.1_SS4-IPA.1.1": {
            "jenis": "Saling Melengkapi",
            "alasan": "Penilaian proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) saling melengkapi dengan pengukuran persentase penyelesaian rekomendasi BPK RI terkait pengelolaan dan penatausahaan Barang Milik Negara pada parameter Penyelesaian Temuan BPK terkait BMN (sub-parameter Akuntabel & Produktif, sasaran strategis Pengelolaan BMN yang Akuntabel dan Produktif) IPA.",
            "rekomendasi": "Disarankan menyinkronkan penataan distribusi beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali dengan pemantauan persentase penyelesaian rekomendasi BPK RI terkait pengelolaan dan penatausahaan Barang Milik Negara pada IPA."
      },
      "SS4-KK.KU.1.1_SS4-IPA.1.2": {
            "jenis": "Saling Melengkapi",
            "alasan": "Penilaian proporsionalitas sebaran volume dan beban kerja di setiap tingkatan manajerial dan unit organisasi pada indikator Rentang Kendali — pernyataan Distribusi Beban Kerja (aspek Ketepatan Ukuran) saling melengkapi dengan pengukuran pencapaian target Penerimaan Negara Bukan Pajak yang bersumber dari pemanfaatan dan pemindahtanganan BMN pada parameter Realisasi PNBP dari Pengelolaan BMN (sub-parameter Akuntabel & Produktif, sasaran strategis Pengelolaan BMN yang Akuntabel dan Produktif) IPA.",
            "rekomendasi": "Disarankan menyinkronkan proporsionalitas sebaran beban kerja manajerial dan unit organisasi pada indikator Rentang Kendali dengan pengelolaan pemanfaatan dan pemindahtanganan Barang Milik Negara guna mendukung pencapaian target Realisasi PNBP dari Pengelolaan BMN pada IPA."
      },
      "SS4-KK.KU.2.1_SS4-CKKP.KO.1.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap efektivitas dan efisiensi yang diukur dari perubahan kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, serta penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung penilaian kinerja sasaran strategis pada cakupan Capaian IKSS K/L (kategori Kinerja Organisasi Kementerian/Lembaga) dalam CKKP.",
            "rekomendasi": "Disarankan menyelaraskan peningkatan kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, dan pengurangan duplikasi hasil penyederhanaan struktur organisasi pada indikator Departemensi (Pembidangan) dengan upaya pencapaian Indikator Kinerja Sasaran Strategis (IKSS) K/L pada CKKP."
      },
      "SS4-KK.KU.2.1_SS4-CKKP.KO.1.2": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung penilaian kinerja sasaran strategis pada cakupan Realisasi seluruh RO (kategori Kinerja Organisasi Kementerian/Lembaga) dalam CKKP.",
            "rekomendasi": "Disarankan memanfaatkan kejelasan tanggung jawab, kecepatan proses, dan efisiensi sumber daya dari penyederhanaan struktur organisasi pada indikator Departemensi (Pembidangan) untuk mengoptimalkan realisasi seluruh Rincian Output (RO) pada CKKP."
      },
      "SS4-KK.KU.2.1_SS4-CKKP.KP.1.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung pencapaian indikator Memiliki RO PN dengan cakupan capaian indikator SUP/PN/PP/KP, realisasi RO PN, dan added value penilaian (kategori Kinerja Penugasan RKP) pada CKKP.",
            "rekomendasi": "Disarankan menyelaraskan kejelasan tanggung jawab dan rentang koordinasi hasil penyederhanaan pembidangan struktur organisasi dengan pengendalian capaian indikator SUP/PN/PP/KP, realisasi RO PN, serta added value penilaian pada indikator Memiliki RO PN dalam CKKP."
      },
      "SS4-KK.KU.2.1_SS4-CKKP.KP.2.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung pencapaian indikator Memiliki Indikator Penugasan RKP dengan cakupan capaian indikator SUP/PN/PP/KP, realisasi RO PN, dan added value penilaian (kategori Kinerja Penugasan RKP) pada CKKP.",
            "rekomendasi": "Disarankan menyelaraskan efektivitas dan efisiensi struktur organisasi hasil penyederhanaan pembidangan dengan pemenuhan capaian indikator SUP/PN/PP/KP, realisasi RO PN, dan added value penilaian pada indikator Memiliki Indikator Penugasan RKP dalam CKKP."
      },
      "SS4-KK.KU.2.1_SS4-SPIP.1.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi yang diukur dari perubahan kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung tingkat pencapaian sasaran strategis instansi pemerintah secara tepat guna, hemat sumber daya, dan berdaya hasil tinggi sesuai target pada sub uraian Efektivitas dan Efisiensi (komponen Sasaran Strategis K/L/D) SPIP.",
            "rekomendasi": "Disarankan menyelaraskan evaluasi dampak penyederhanaan struktur organisasi (kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan efisiensi sumber daya) dengan penerapan Unsur SPIP guna memperkuat efektivitas dan efisiensi pencapaian sasaran strategis K/L/D."
      },
      "SS4-KK.KU.2.1_SS4-SPIP.1.2": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, dan pengurangan duplikasi pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung kepastian penyajian laporan keuangan yang wajar, tepat waktu, akurat, dan dapat dipertanggungjawabkan sesuai Standar Akuntansi Pemerintahan (SAP) pada sub uraian Keandalan Pelaporan Keuangan (komponen Sasaran Strategis K/L/D) SPIP.",
            "rekomendasi": "Disarankan memanfaatkan kejelasan tanggung jawab, rentang koordinasi, dan pengurangan duplikasi hasil penyederhanaan struktur organisasi pada indikator Departemensi (Pembidangan) untuk memperkuat penerapan Unsur SPIP dalam menjamin keandalan pelaporan keuangan sesuai Standar Akuntansi Pemerintahan (SAP)."
      },
      "SS4-KK.KU.2.1_SS4-SPIP.2.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, pengurangan duplikasi, dan efisiensi penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung pengendalian intern untuk melindungi aset dan BMN dari risiko kehilangan, kerusakan, pemborosan, penyalahgunaan, maupun pemanfaatan yang tidak sah pada sub uraian Pengamanan Aset Negara (komponen Strategi Pencapaian Sasaran Strategis) SPIP.",
            "rekomendasi": "Disarankan menyelaraskan kejelasan tanggung jawab dan efisiensi penggunaan sumber daya hasil penyederhanaan struktur organisasi pada indikator Departemensi (Pembidangan) dengan penerapan Unsur SPIP pada sub uraian Pengamanan Aset Negara guna mencegah pemborosan dan melindungi aset serta BMN."
      },
      "SS4-KK.KU.2.1_SS4-SPIP.2.2": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, dan pengurangan duplikasi pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung kepatuhan seluruh unit kerja dan aparatur terhadap ketentuan hukum, peraturan perundang-undangan, dan standar operasional prosedur yang berlaku pada sub uraian Ketaatan Terhadap Peraturan Perundang-undangan (komponen Strategi Pencapaian Sasaran Strategis) SPIP.",
            "rekomendasi": "Disarankan menyelaraskan penataan kejelasan tanggung jawab dan alur koordinasi hasil penyederhanaan struktur organisasi pada indikator Departemensi (Pembidangan) dengan penerapan Unsur SPIP guna memastikan ketaatan seluruh unit kerja dan aparatur terhadap peraturan perundang-undangan serta standar operasional prosedur."
      },
      "SS4-KK.KU.2.1_SS4-SAKIP.2": {
            "jenis": "Saling Melengkapi",
            "alasan": "Pengukuran dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) saling melengkapi dengan penilaian komponen Pengukuran Kinerja (sub-komponen Pengukuran Kinerja telah dilakukan) yang mencakup pedoman teknis, definisi operasional, mekanisme pengumpulan data kinerja berkala dan berjenjang, serta pemanfaatannya pada SAKIP.",
            "rekomendasi": "Disarankan menyinkronkan kejelasan tanggung jawab dan rentang koordinasi hasil penyederhanaan struktur organisasi pada indikator Departemensi (Pembidangan) dengan mekanisme pengumpulan data serta pelaksanaan Pengukuran Kinerja secara berkala dan berjenjang pada SAKIP."
      },
      "SS4-KK.KU.2.1_SS4-SAKIP.3": {
            "jenis": "Saling Melengkapi",
            "alasan": "Pengukuran dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, kecepatan proses, pengurangan duplikasi, dan efisiensi sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) saling melengkapi dengan penilaian komponen Pelaporan Kinerja (sub-komponen Dokumen Laporan Kinerja telah tersedia dan memenuhi standar) yang menguji ketepatan waktu, reviu, pengungkapan pencapaian dan efisiensi sumber daya, serta pemanfaatan informasi laporan kinerja pada SAKIP.",
            "rekomendasi": "Disarankan menyinkronkan evaluasi dampak penyederhanaan struktur organisasi terkait pencapaian dan efisiensi penggunaan sumber daya pada indikator Departemensi (Pembidangan) dengan penyusunan dan pemanfaatan Dokumen Laporan Kinerja yang memenuhi standar pada komponen Pelaporan Kinerja SAKIP."
      },
      "SS4-KK.KU.2.1_SS4-SAKIP.4": {
            "jenis": "Saling Melengkapi",
            "alasan": "Pengukuran dampak penyederhanaan struktur organisasi terhadap efektivitas dan efisiensi (kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya) pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) saling melengkapi dengan penilaian komponen Evaluasi Akuntabilitas Kinerja Internal (sub-komponen Evaluasi Akuntabilitas Kinerja Internal telah dilaksanakan secara berkualitas) secara berjenjang pada seluruh unit kerja dalam SAKIP.",
            "rekomendasi": "Disarankan menyinkronkan pengukuran dampak penyederhanaan struktur organisasi pada indikator Departemensi (Pembidangan) dengan pelaksanaan serta tindak lanjut rekomendasi Evaluasi Akuntabilitas Kinerja Internal secara berjenjang pada seluruh unit kerja dalam SAKIP."
      },
      "SS4-KK.KU.2.1_SS4-ELPPD.TP.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap efektivitas dan efisiensi (kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya) pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung penilaian keberhasilan daerah dalam mencapai sasaran pembangunan makro (ekonomi, sosial, lingkungan) serta menjalankan layanan urusan pemerintahan wajib dan pilihan pada butir penilaian Capaian Pembangunan Makro dan Layanan Urusan (kelompok penilaian Tujuan Penilaian) ELPPD.",
            "rekomendasi": "Disarankan menyelaraskan penyederhanaan pembidangan struktur organisasi (kejelasan tanggung jawab, rentang koordinasi, dan pengurangan duplikasi) dengan penyelenggaraan layanan urusan pemerintahan wajib dan pilihan guna mendukung pencapaian sasaran pembangunan makro daerah pada ELPPD."
      },
      "SS4-KK.KU.2.1_SS4-ELPPD.IU.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan efisiensi sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung peningkatan cakupan layanan urusan pemerintahan dan pertumbuhan ekonomi daerah pada butir penilaian Pertumbuhan Ekonomi & Cakupan Layanan Urusan (kelompok penilaian Indikator Utama) ELPPD.",
            "rekomendasi": "Disarankan menyelaraskan kejelasan tanggung jawab, kecepatan proses, dan pengurangan duplikasi hasil penyederhanaan pembidangan struktur organisasi dengan perluasan cakupan layanan urusan pemerintahan guna mendukung capaian indikator utama Pertumbuhan Ekonomi pada ELPPD."
      },
      "SS4-KK.KU.2.1_SS4-ELPPD.IU.2": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung peningkatan kualitas layanan dasar urusan wajib dan capaian Indeks Pembangunan Manusia (IPM) pada butir penilaian Indeks Pembangunan Manusia & Layanan Dasar (kelompok penilaian Indikator Utama) ELPPD.",
            "rekomendasi": "Disarankan menyelaraskan efektivitas dan efisiensi hasil penyederhanaan pembidangan struktur organisasi dengan peningkatan kualitas layanan dasar urusan wajib guna mendukung capaian Indeks Pembangunan Manusia (IPM) pada ELPPD."
      },
      "SS4-KK.KU.2.1_SS4-ELPPD.IU.3": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap efektivitas dan efisiensi yang diukur dari perubahan kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, serta penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung efisiensi dan efektivitas pelaksanaan urusan pemerintahan serta tingkat penurunan kemiskinan pada butir penilaian Pengentasan Kemiskinan & Efisiensi Urusan (kelompok penilaian Indikator Utama) ELPPD.",
            "rekomendasi": "Disarankan menyelaraskan pengurangan duplikasi, kecepatan proses, dan efisiensi penggunaan sumber daya hasil penyederhanaan struktur organisasi dengan peningkatan efisiensi dan efektivitas pelaksanaan urusan pemerintahan guna mendukung penurunan kemiskinan pada ELPPD."
      },
      "SS4-KK.KU.2.1_SS4-ELPPD.IU.4": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung inovasi daerah dalam penyelenggaraan urusan serta capaian indeks kualitas lingkungan hidup daerah pada butir penilaian Kualitas Lingkungan Hidup & Inovasi Daerah (kelompok penilaian Indikator Utama) ELPPD.",
            "rekomendasi": "Disarankan menyelaraskan kejelasan tanggung jawab dan rentang koordinasi hasil penyederhanaan pembidangan struktur organisasi dengan penguatan inovasi daerah dalam penyelenggaraan urusan pemerintahan serta peningkatan indeks kualitas lingkungan hidup daerah pada ELPPD."
      },
      "SS4-KK.KU.2.1_SS4-ELPPD.SD.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, dan pengurangan duplikasi pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung ketertiban penyediaan data makro daerah (BPS dan OPD terkait) serta data capaian kinerja urusan dari masing-masing OPD pada butir penilaian Data Makro Daerah & Kinerja OPD (kelompok penilaian Sumber Data) ELPPD.",
            "rekomendasi": "Disarankan memanfaatkan kejelasan tanggung jawab dan rentang koordinasi hasil penyederhanaan pembidangan struktur organisasi untuk memperkuat koordinasi penyediaan data makro daerah (BPS dan OPD terkait) serta data capaian kinerja urusan dari masing-masing OPD pada ELPPD."
      },
      "SS4-KK.KU.2.1_SS4-ELPPD.SD.2": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, dan pengurangan duplikasi pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung ketersediaan dokumen perencanaan dan laporan pembangunan daerah serta laporan pelaksanaan program dan kegiatan urusan pada butir penilaian Dokumen Perencanaan & Laporan Kegiatan (kelompok penilaian Sumber Data) ELPPD.",
            "rekomendasi": "Disarankan menyelaraskan kejelasan tanggung jawab dan kecepatan proses hasil penyederhanaan struktur organisasi dengan ketertiban penyusunan dokumen perencanaan dan laporan pembangunan daerah serta laporan pelaksanaan program dan kegiatan urusan pada ELPPD."
      },
      "SS4-KK.KU.2.1_SS4-ELPPD.K.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan efisiensi sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung keterpaduan antara gambaran umum capaian pembangunan makro daerah dan penjabarannya dalam bentuk layanan serta kewenangan urusan pemerintahan daerah pada butir penilaian Keterpaduan Capaian Makro dan Urusan Pemerintahan (kelompok penilaian Keterkaitan) ELPPD.",
            "rekomendasi": "Disarankan menyelaraskan penataan pembidangan dan penyederhanaan struktur organisasi dengan penjabaran kinerja makro daerah ke dalam bentuk layanan dan kewenangan urusan pemerintahan daerah pada butir penilaian Keterpaduan Capaian Makro dan Urusan Pemerintahan ELPPD."
      },
      "SS4-KK.KU.2.1_SS4-IKPA.3.1": {
            "jenis": "Mendukung",
            "alasan": "Dampak penyederhanaan struktur organisasi terhadap kejelasan tanggung jawab, rentang koordinasi, kecepatan proses, pengurangan duplikasi, dan efisiensi penggunaan sumber daya pada indikator Departemensi (Pembidangan) — pernyataan Penyederhanaan (aspek Ketepatan Ukuran) mendukung tingkat ketepatan dan ketercapaian target output rincian belanja (RO) yang dilaporkan satker secara berkala melalui aplikasi SMART/e-Monev pada indikator Capaian Output (aspek Kualitas Hasil Pelaksanaan Anggaran) IKPA.",
            "rekomendasi": "Disarankan menyelaraskan kejelasan tanggung jawab, kecepatan proses, dan efisiensi sumber daya hasil penyederhanaan struktur organisasi pada indikator Departemensi (Pembidangan) dengan pengendalian serta pelaporan berkala ketercapaian target output rincian belanja (RO) satker melalui aplikasi SMART/e-Monev pada IKPA."
      },
      "SS4-KK.KP.3.1_SS4-IPPN.1.a.1": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan kesesuaian muatan (sasaran, target, satuan target) dalam Renstra K/L terhadap muatan di dalam RPJMN pada indikator Kepatuhan Renstra K/L terhadap RPJMN dalam IPPN.",
            "rekomendasi": "Disarankan menyelaraskan penyusunan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja di lingkungan internal instansi dengan perumusan muatan sasaran, target, dan satuan target dalam Renstra K/L agar sesuai dengan muatan di dalam RPJMN pada IPPN."
      },
      "SS4-KK.KP.3.1_SS4-IPPN.1.b.1": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan konsistensi muatan sasaran (strategis, program, kegiatan), target, dan satuan target dalam Renja K/L terhadap muatan di dalam Renstra K/L pada indikator Konsistensi Renja K/L terhadap Renstra K/L dalam IPPN.",
            "rekomendasi": "Disarankan menyelaraskan penetapan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan penyusunan muatan sasaran (strategis, program, kegiatan), target, dan satuan target dalam Renja K/L agar konsisten dengan muatan di dalam Renstra K/L pada IPPN."
      },
      "SS4-KK.KP.3.1_SS4-IPPN.1.c.1": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan kesesuaian output prioritas dalam Renja K/L terhadap output proyek prioritas di dalam koridor Kegiatan Prioritas Utama (KPU) RKP pada indikator Kepatuhan Renja K/L terhadap RKP dalam IPPN.",
            "rekomendasi": "Disarankan menyelaraskan perumusan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan penetapan output prioritas dalam Renja K/L agar sesuai dengan output proyek prioritas di dalam koridor Kegiatan Prioritas Utama (KPU) RKP pada IPPN."
      },
      "SS4-KK.KP.3.1_SS4-IPPN.1.c.2": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan kesesuaian target dan satuan output prioritas dalam Renja K/L terhadap target dan satuan output proyek prioritas di dalam koridor Kegiatan Prioritas Utama (KPU) RKP pada indikator Kepatuhan Renja K/L terhadap RKP dalam IPPN.",
            "rekomendasi": "Disarankan menyelaraskan penyusunan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan penetapan target dan satuan output prioritas dalam Renja K/L agar sesuai dengan target dan satuan output proyek prioritas di dalam koridor Kegiatan Prioritas Utama (KPU) RKP pada IPPN."
      },
      "SS4-KK.KP.3.1_SS4-IPPN.1.c.3": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan kesesuaian output prioritas dalam Renja K/L terhadap output proyek prioritas di dalam koridor Prioritas Nasional RKP pada indikator Kepatuhan Renja K/L terhadap RKP dalam IPPN.",
            "rekomendasi": "Disarankan menyelaraskan perumusan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan penetapan output prioritas dalam Renja K/L agar sesuai dengan output proyek prioritas di dalam koridor Prioritas Nasional RKP pada IPPN."
      },
      "SS4-KK.KP.3.1_SS4-IPPN.1.c.4": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan kesesuaian target dan satuan output prioritas dalam Renja K/L terhadap target dan satuan output proyek prioritas di dalam koridor Prioritas Nasional RKP pada indikator Kepatuhan Renja K/L terhadap RKP dalam IPPN.",
            "rekomendasi": "Disarankan menyelaraskan penetapan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan perumusan target dan satuan output prioritas dalam Renja K/L agar sesuai dengan target dan satuan output proyek prioritas di dalam koridor Prioritas Nasional RKP pada IPPN."
      },
      "SS4-KK.KP.3.1_SS4-SPIP.1.1": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan tingkat pencapaian sasaran strategis instansi pemerintah secara tepat guna, hemat sumber daya, dan berdaya hasil tinggi sesuai target yang telah ditetapkan pada sub uraian Efektivitas dan Efisiensi (komponen Sasaran Strategis K/L/D) SPIP.",
            "rekomendasi": "Disarankan menyelaraskan penyusunan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan penerapan Unsur SPIP pada komponen Sasaran Strategis K/L/D guna mewujudkan pencapaian target sasaran strategis instansi secara efektif dan efisien."
      },
      "SS4-KK.KP.3.1_SS4-SPIP.1.2": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan pengendalian sasaran strategis K/L/D dalam menjamin penyajian laporan keuangan yang wajar, tepat waktu, akurat, dan dapat dipertanggungjawabkan sesuai Standar Akuntansi Pemerintahan (SAP) pada sub uraian Keandalan Pelaporan Keuangan SPIP.",
            "rekomendasi": "Disarankan menyelaraskan perencanaan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan penerapan Unsur SPIP pada komponen Sasaran Strategis K/L/D guna mendukung keandalan pelaporan keuangan yang akurat dan sesuai Standar Akuntansi Pemerintahan (SAP)."
      },
      "SS4-KK.KP.3.1_SS4-SPIP.2.1": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan strategi pencapaian sasaran strategis melalui pengendalian intern untuk melindungi aset dan BMN dari risiko kehilangan, kerusakan, pemborosan, penyalahgunaan, maupun pemanfaatan yang tidak sah pada sub uraian Pengamanan Aset Negara SPIP.",
            "rekomendasi": "Disarankan menyelaraskan penyusunan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan penerapan Unsur SPIP pada komponen Strategi Pencapaian Sasaran Strategis guna mencegah pemborosan serta memperkuat pengendalian intern atas pengamanan aset negara dan BMN."
      },
      "SS4-KK.KP.3.1_SS4-SPIP.2.2": {
            "jenis": "Keselarasan Perencanaan",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) memiliki keselarasan perencanaan dengan strategi pencapaian sasaran strategis dalam memastikan kepatuhan seluruh unit kerja dan aparatur terhadap ketentuan hukum, peraturan perundang-undangan, dan standar operasional prosedur yang berlaku pada sub uraian Ketaatan Terhadap Peraturan Perundang-undangan SPIP.",
            "rekomendasi": "Disarankan menyelaraskan perumusan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja internal dengan penerapan Unsur SPIP pada komponen Strategi Pencapaian Sasaran Strategis guna menjamin ketaatan seluruh unit kerja dan aparatur terhadap peraturan perundang-undangan serta standar operasional prosedur."
      },
      "SS4-KK.KP.3.1_SS4-SAKIP.1": {
            "jenis": "Saling Melengkapi",
            "alasan": "Penyusunan sasaran dan target kinerja bersama (shared outcomes) yang melibatkan kolaborasi lintas unit kerja di lingkungan internal instansi pada indikator Proses Perencanaan — pernyataan Shared-Outcomes Internal (aspek Ketepatan Proses) saling melengkapi dengan ketersediaan pedoman teknis serta dokumen perencanaan kinerja jangka panjang, jangka menengah, jangka pendek, aktivitas, dan anggaran yang dirumuskan oleh setiap unit/satuan kerja pada komponen Perencanaan Kinerja (sub-komponen Dokumen Perencanaan Kinerja telah tersedia) SAKIP.",
            "rekomendasi": "Disarankan mengintegrasikan penyusunan sasaran dan target kinerja bersama (shared-outcomes) lintas unit kerja internal ke dalam perumusan dan penetapan dokumen Perencanaan Kinerja (jangka panjang, menengah, pendek, aktivitas, dan anggaran pendukung kinerja) pada setiap unit/satuan kerja dalam SAKIP."
      },
      "SS4-KK.TK.3.1_SS4-SPIP.1.1": {
            "jenis": "Beririsan Substansi",
            "alasan": "Penerapan manajemen risiko terintegrasi dalam setiap perencanaan dan pelaksanaan kegiatan guna memitigasi hambatan pencapaian tujuan organisasi pada indikator Pengendalian Risiko — pernyataan Implementasi (aspek Tata Kelola) beririsan substansi dengan penerapan Unsur SPIP (Lingkungan Pengendalian, Penilaian Risiko, Kegiatan Pengendalian, Informasi & Komunikasi, dan Pemantauan) dalam mewujudkan tingkat pencapaian sasaran strategis instansi pemerintah secara tepat guna, hemat sumber daya, dan berdaya hasil tinggi pada sub uraian Efektivitas dan Efisiensi SPIP.",
            "rekomendasi": "Disarankan menyelaraskan implementasi manajemen risiko terintegrasi pada perencanaan dan pelaksanaan kegiatan (indikator Pengendalian Risiko KK) dengan pelaksanaan Unsur SPIP pada sub uraian Efektivitas dan Efisiensi agar mitigasi hambatan pencapaian sasaran strategis K/L/D berjalan terpadu tanpa duplikasi penilaian."
      },
      "SS4-KK.TK.3.1_SS4-SPIP.1.2": {
            "jenis": "Beririsan Substansi",
            "alasan": "Penerapan manajemen risiko terintegrasi dalam setiap perencanaan dan pelaksanaan kegiatan guna memitigasi hambatan pencapaian tujuan organisasi pada indikator Pengendalian Risiko — pernyataan Implementasi (aspek Tata Kelola) beririsan substansi dengan penerapan Unsur SPIP dalam menjamin kepastian penyajian laporan keuangan yang wajar, tepat waktu, akurat, dan dapat dipertanggungjawabkan sesuai Standar Akuntansi Pemerintahan (SAP) pada sub uraian Keandalan Pelaporan Keuangan SPIP.",
            "rekomendasi": "Disarankan menyelaraskan implementasi manajemen risiko terintegrasi pada setiap perencanaan dan pelaksanaan kegiatan (indikator Pengendalian Risiko KK) dengan penerapan Unsur SPIP pada sub uraian Keandalan Pelaporan Keuangan guna memitigasi risiko dalam proses penyajian laporan keuangan sesuai Standar Akuntansi Pemerintahan (SAP)."
      },
      "SS4-KK.TK.3.1_SS4-SPIP.2.1": {
            "jenis": "Beririsan Substansi",
            "alasan": "Penerapan manajemen risiko terintegrasi dalam setiap perencanaan dan pelaksanaan kegiatan guna memitigasi hambatan pencapaian tujuan organisasi pada indikator Pengendalian Risiko — pernyataan Implementasi (aspek Tata Kelola) beririsan substansi dengan pengendalian intern pada Unsur SPIP untuk melindungi aset dan BMN dari risiko kehilangan, kerusakan, pemborosan, penyalahgunaan, maupun pemanfaatan yang tidak sah pada sub uraian Pengamanan Aset Negara SPIP.",
            "rekomendasi": "Disarankan menyinkronkan implementasi manajemen risiko terintegrasi dalam perencanaan dan pelaksanaan kegiatan (indikator Pengendalian Risiko KK) dengan pelaksanaan Unsur SPIP pada sub uraian Pengamanan Aset Negara agar mitigasi risiko kehilangan, kerusakan, pemborosan, dan penyalahgunaan aset serta BMN terintegrasi."
      },
      "SS4-KK.TK.3.1_SS4-SPIP.2.2": {
            "jenis": "Beririsan Substansi",
            "alasan": "Penerapan manajemen risiko terintegrasi dalam setiap perencanaan dan pelaksanaan kegiatan guna memitigasi hambatan pencapaian tujuan organisasi pada indikator Pengendalian Risiko — pernyataan Implementasi (aspek Tata Kelola) beririsan substansi dengan penerapan Unsur SPIP dalam memastikan kepatuhan seluruh unit kerja dan aparatur terhadap ketentuan hukum, peraturan perundang-undangan, dan standar operasional prosedur yang berlaku pada sub uraian Ketaatan Terhadap Peraturan Perundang-undangan SPIP.",
            "rekomendasi": "Disarankan menyelaraskan implementasi manajemen risiko terintegrasi pada perencanaan dan pelaksanaan kegiatan (indikator Pengendalian Risiko KK) dengan penerapan Unsur SPIP pada sub uraian Ketaatan Terhadap Peraturan Perundang-undangan guna memitigasi risiko ketidakpatuhan terhadap ketentuan hukum dan standar operasional prosedur secara konsisten."
      }
},
