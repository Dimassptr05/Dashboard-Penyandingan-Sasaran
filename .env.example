# =============================================================================
# KONFIGURASI GOOGLE SHEETS & NETLIFY FUNCTION (PORTAL RELASI RB SASARAN 4)
# =============================================================================
# Di Netlify: Buka menu Projects -> Site configuration -> Environment variables.
# =============================================================================

# 1. ID Spreadsheet Google Sheets Master
SPREADSHEET_ID=1LVXNqK7ehp2fLtrFstnTcM2jiyOeWCPhR1CdC14jwDs

# 2. Nama Sheet Final Sasaran 4 (Sumber Data Resmi)
SHEET_NAME_SASARAN4_DEV=sasaran 4 -dev

# 3. GID Sheet Tab sasaran 4 -dev
SHEET_GID_SASARAN4_DEV=1144784169

# Catatan Migrasi:
# Variabel lama SHEET_NAME=sasaran4-js dan SHEET_GID=1944797946 sudah dinonaktifkan
# dan tidak lagi dibaca oleh endpoint Sasaran 4.

# 4. Konfigurasi Khusus Analisis Indeks Score Evaluasi 2025 (Terpisah dari Sasaran 4)
INDEKS_SCORE_SPREADSHEET_ID=1i4kBAqUUpxD6NfBFOPsibPMX902KGFP7Wz3JaJ1nzRQ
INDEKS_SCORE_SHEET_NAME=Sheet2
INDEKS_SCORE_SHEET_GID=860170702

